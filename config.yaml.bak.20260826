cache:
  max_size_mb: 500
  ttl: 86400
gpu:
  backend: auto
history:
  db_path: data/history.db
  max_records: 10000
i18n:
  available_locales:
  - zh
  - zh-TW
  - en
  - ja
  - fr
  default_locale: zh
inference:
  attention_mode: sdpa
  batch_size: 5
  blocks_to_swap: 32
  cache_model: false
  color_correction: lab
  distilled_mode: true
  enable_debug: false
  fp8_enabled: false
  inference_mode: distilled
  input_noise_scale: 0.0
  latent_noise_scale: 0.0
  max_resolution: 0
  memory_min_available_gb: 2.0
  memory_threshold: 0.95
  offload_device: cpu
  prepend_frames: 0
  resolution: 2048
  restoration_guidance_scale: 0.0
  seed: -1
  swap_io_components: true
  temporal_overlap: 0
  temporal_segment_overlap: 0
  temporal_segment_size: 5
  torch_compile:
    backend: inductor
    dynamic: false
    enabled: false
    fullgraph: false
    mode: default
  uniform_batch_size: false
  vae_overlap: 512
  vae_tile_size: 1024
logging:
  backup_count: 3
  file: logs/app.log
  level: INFO
  max_size_mb: 50
model:
  auto_load: false
  default_precision: fp16
  default_size: 3b
  device: auto
  model_source_mode: portable
  models:
    3b:
      checkpoint_fp16: seedvr2_ema_3b_fp16.safetensors
      checkpoint_fp8: seedvr2_ema_3b_fp8_e4m3fn.safetensors
      config_dir: configs_3b
      min_vram_fp16_gb: 16
      min_vram_fp8_gb: 8
      name: SeedVR2-3B
      neg_emb: neg_emb.pt
      num_blocks: 32
      pos_emb: pos_emb.pt
      vae_checkpoint: ema_vae_fp16.safetensors
    7b:
      checkpoint_fp16: seedvr2_ema_7b_fp16.safetensors
      checkpoint_fp8: seedvr2_ema_7b_fp8_e4m3fn.safetensors
      config_dir: configs_7b
      min_vram_fp16_gb: 24
      min_vram_fp8_gb: 12
      name: SeedVR2-7B
      neg_emb: neg_emb.pt
      num_blocks: 36
      pos_emb: pos_emb.pt
      vae_checkpoint: ema_vae_fp16.safetensors
    7b_sharp:
      checkpoint_fp16: seedvr2_ema_7b_sharp_fp16.safetensors
      checkpoint_fp8: seedvr2_ema_7b_sharp_fp8_e4m3fn.safetensors
      config_dir: configs_7b
      min_vram_fp16_gb: 24
      min_vram_fp8_gb: 12
      name: SeedVR2-7B-Sharp
      neg_emb: neg_emb.pt
      num_blocks: 36
      pos_emb: pos_emb.pt
      vae_checkpoint: ema_vae_fp16.safetensors
  pretrained_dir: model
  shared_models_root: ''
restore:
  default_resolution_h: 1080
  default_resolution_w: 1920
  default_scale_factor: 2.0
  detail_enhancement: cinematic
  seed: 42
  sp_size: 1
  temporal_consistency: 0.8
runtime:
  batch:
    max_retries: 2
    retry_base_delay_seconds: 1.0
    retry_max_delay_seconds: 30.0
  security:
    allowed_base_dirs:
    - outputs/
    - data/uploads/
    rate_limit_per_minute: 30
  sse:
    heartbeat_interval_seconds: 30
    max_duration_seconds: 300
    poll_interval_seconds: 0.5
  task:
    auto_recover: false
    checkpoint_dir: data/checkpoints
    checkpoint_every: 1
    id_length: 16
    max_timeout_seconds: 86400
    queue_maxsize: 100
  upload:
    chunk_size_bytes: 8192
    large_file_threshold_mb: 10
server:
  allowed_origins:
  - http://127.0.0.1:7870
  - http://localhost:7870
  auto_open_browser: true
  debug: false
  host: 127.0.0.1
  port: 7870
user_preferences:
  accordion_expanded_groups:
  - basic
  - condition
  blocks_to_swap: 0
  blockswap_enabled: false
  default_batch_size: 5
  default_cfg_scale: 3.0
  default_color_correction: lab
  default_denoising_strength: 0.6
  default_max_resolution: 0
  default_model: 3b_fp16
  default_resolution: 2048
  default_sampler: dpmpp_2m_sde
  default_seed: -1
  default_steps: 20
  default_vae: ema_vae_fp16
  output_format: png
  output_path_template: '{input_dir}/restored/{input_name}{ext}'
  output_quality: 95
  recent_model_path: ''
  restore_form_values: {}
  restore_unlock_state: {}
  slider_comparison_enabled: true
  step_execution_enabled: false
  vae_tile_size: 512
  vae_tiling_enabled: false
