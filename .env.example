# SeedVR2 环境变量配置模板
# 复制为 .env 后按需修改（.env 文件已被 .gitignore 忽略，不会提交到仓库）
# 显式系统环境变量优先级高于 .env 文件（使用 os.environ.setdefault）

# ──────────────────────────────────────────────────────────────
# Intel OpenMP 重复库兼容（一般不需要改）
# ──────────────────────────────────────────────────────────────
KMP_DUPLICATE_LIB_OK=TRUE

# ──────────────────────────────────────────────────────────────
# PyTorch 显存分配器：expandable_segments 减少碎片化
# 调试时可改为 max_split_size_mb:128 等其他配置
# ──────────────────────────────────────────────────────────────
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PYTORCH_ALLOC_CONF=expandable_segments:True

# ──────────────────────────────────────────────────────────────
# HuggingFace / Transformers 离线模式（防止联网卡住）
# ──────────────────────────────────────────────────────────────
HF_HUB_OFFLINE=1

# ──────────────────────────────────────────────────────────────
# 文件名级显式 AI 生成标识：默认关闭（产物名保持交付原样）；
# 对外服务需文件名标识时取消下行注释开启。画面内始终无可见标识。
# ──────────────────────────────────────────────────────────────
# SEEDVR2_EXPLICIT_AI_LABEL=1

# ──────────────────────────────────────────────────────────────
# 取证模式：JPEG/WebP 输出强制转存为 PNG（无损），使隐式水印确定性可验证。
# 代价是产物体积变大；不开则依赖落盘复验判定真伪（有损编码下水印为临界存活）。
# ──────────────────────────────────────────────────────────────
# SEEDVR2_WATERMARK_PROOF_MODE=1

# ──────────────────────────────────────────────────────────────
# 溯源记录目录（水印缺失时的显式元数据标识落点，默认 <仓库>/data/provenance）
# ──────────────────────────────────────────────────────────────
# SEEDVR2_PROVENANCE_DIR=/var/lib/seedvr2/provenance
TRANSFORMERS_OFFLINE=1

# ──────────────────────────────────────────────────────────────
# Basic Auth 密码（公网部署时通过环境变量注入，避免硬编码）
# ──────────────────────────────────────────────────────────────
# SEEDVR2_AUTH_PASSWORD=your_secure_password_here

# ──────────────────────────────────────────────────────────────
# 日志配置（环境变量覆盖，优先级高于 config.yaml）
# ──────────────────────────────────────────────────────────────
# 运行环境：development / production / test
ENVIRONMENT=development

# 日志级别：DEBUG / INFO / WARNING / ERROR
# 生产环境建议 INFO 及以上，禁止输出 DEBUG 调试日志
LOG_LEVEL=INFO

# 日志文件路径（默认 logs/app.log）
LOG_PATH=logs/app.log
